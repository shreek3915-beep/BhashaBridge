body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background-color: #0f172a;
    color: #f8fafc;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    margin: 0;
}
.container {
    background: #1e293b;
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.5);
    width: 400px;
    text-align: center;
}
header h1 { margin: 0 0 0.5rem 0; color: #38bdf8; }
header p { margin: 0 0 1.5rem 0; color: #94a3b8; font-size: 0.9rem; }
.status-card {
    background: #0f172a;
    padding: 0.5rem;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
}
.status-dot { width: 8px; height: 8px; border-radius: 50%; }
.disconnected { background: #ef4444; }
.ready { background: #22c55e; }
.recording { background: #eab308; animation: pulse 1s infinite; }
.processing { background: #a855f7; }
.controls { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem; }
.btn {
    padding: 0.75rem; border: none; border-radius: 6px; font-weight: 600; cursor: pointer; transition: 0.2s;
}
.primary { background: #0284c7; color: white; }
.primary:hover { background: #0369a1; }
.primary:disabled { background: #334155; color: #64748b; cursor: not-allowed; }
.secondary { background: #334155; color: #e2e8f0; }
.secondary:hover { background: #475569; }
.conversation-box { text-align: left; background: #0f172a; padding: 1rem; border-radius: 8px; }
.log-entry { margin-bottom: 1rem; }
.log-entry strong { font-size: 0.8rem; color: #38bdf8; }
.log-entry p { margin: 0.25rem 0 0 0; font-size: 0.95rem; }
.placeholder { color: #475569; font-style: italic; }
@keyframes pulse { 0% { opacity: 0.5; } 50% { opacity: 1; } 100% { opacity: 0.5; } }
